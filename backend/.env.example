# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Download serviceAccountKey.json from Firebase Console:
#   Project Settings → Service accounts → Generate new private key
# Place it at: backend/firebase/serviceAccountKey.json
# Then set the path below (relative to the backend/ directory):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase/serviceAccountKey.json
# Required for project-file persistence in Firebase Cloud Storage.
# Copy the bucket name from Firebase Console → Storage.
FIREBASE_STORAGE_BUCKET=

# Alternative — individual credential fields (for CI/CD or secret managers):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=       ← paste with literal \n for newlines

# ── AI Provider (Groq — primary) ──────────────────────────────────────────────
# Get your free API key from: https://console.groq.com/keys
GROQ_API_KEY=
# Maximum source-region plus read-only context sent for one finding-level fix.
# Must be between 1000 and 14000 characters; larger files are targeted by location.
AUTOFIX_MAX_CONTEXT_CHARS=14000

# ── AI Provider (OpenAI — optional, not used by default) ─────────────────────
OPENAI_API_KEY=

# ── Hindsight Memory Layer ────────────────────────────────────────────────────
HINDSIGHT_MAX_EXPERIENCES=8
HINDSIGHT_ENABLED=true

# ── Resumable project uploads ─────────────────────────────────────────────────
# Project folders use authenticated 16 MiB chunks, not a single large request.
# The total defaults to 4 GiB; set this to match available temporary disk space.
MAX_PROJECT_UPLOAD_BYTES=4294967296
PROJECT_UPLOAD_CHUNK_BYTES=16777216
# Temporary project data is removed after this many hours (cleanup runs hourly).
PROJECT_UPLOAD_TTL_HOURS=24
# Optional persistent/shared volume path. Defaults to the OS temporary directory.
PROJECT_UPLOAD_TEMP_DIR=
# Optional additional directory names to skip during source-file analysis.
PROJECT_UPLOAD_SKIP_DIRS=
# Analysis is intentionally bounded; these values cannot exceed code hard caps.
PROJECT_MAX_ANALYSIS_FILES=200
PROJECT_MAX_ANALYSIS_REQUEST_FILES=20
PROJECT_MAX_ANALYSIS_BATCH_BYTES=67108864
PROJECT_MAX_ANALYSIS_FILE_BYTES=20971520
